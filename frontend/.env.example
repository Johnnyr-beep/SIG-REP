# Configuración del frontend de SIGREP.
# Copie este archivo como `.env.local` y ajuste los valores.

# Datos de ejemplo.
#
# Con el valor "1" la aplicación NO llama al backend: sirve un juego de datos
# ficticios desde `src/api/ejemplos.ts` para poder ver y revisar las pantallas
# mientras la API se termina. La interfaz muestra un distintivo permanente
# «DATOS DE EJEMPLO» en la cabecera para que nadie confunda esas cifras con las
# reales.
#
# En producción esta variable debe estar ausente o valer "0".
VITE_SIGREP_EJEMPLOS=0
