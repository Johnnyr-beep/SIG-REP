#!/bin/bash
set -euo pipefail

SERVICE_NAME="${1:-sigrep-sigrepapp-a9zmbg}"
DOMAIN="${2:-sigrep.grupo-santacruz.com}"
DB_SERVICE="${3:-sigrep-grupo-santacruz-ae1smm}"
NETWORK_NAME="dokploy-network"
NETWORK_ID="$(docker network inspect "$NETWORK_NAME" --format '{{.Id}}')"

docker service inspect "$DB_SERVICE" >/dev/null
DB_NETWORKS="$(docker service inspect "$DB_SERVICE" \
  --format '{{range .Spec.TaskTemplate.Networks}}{{println .Target}}{{end}}')"
if ! grep -Fxq "$NETWORK_ID" <<< "$DB_NETWORKS"; then
  echo "ERROR: la base $DB_SERVICE no está conectada a $NETWORK_NAME." >&2
  echo "Conecta la base a esa red desde Dokploy y vuelve a ejecutar el script." >&2
  exit 1
fi

APP_NETWORKS="$(docker service inspect "$SERVICE_NAME" \
  --format '{{range .Spec.TaskTemplate.Networks}}{{println .Target}}{{end}}')"
NETWORK_ARGS=()
if ! grep -Fxq "$NETWORK_ID" <<< "$APP_NETWORKS"; then
  NETWORK_ARGS=(--network-add "$NETWORK_NAME")
fi

docker service update \
  --detach=true \
  "${NETWORK_ARGS[@]}" \
  --label-add 'traefik.enable=true' \
  --label-add "traefik.docker.network=$NETWORK_NAME" \
  --label-add "traefik.http.routers.sigrep.rule=Host(\`$DOMAIN\`)" \
  --label-add 'traefik.http.routers.sigrep.entrypoints=websecure' \
  --label-add 'traefik.http.routers.sigrep.tls=true' \
  --label-add 'traefik.http.routers.sigrep.tls.certresolver=letsencrypt' \
  --label-add 'traefik.http.routers.sigrep.service=sigrep' \
  --label-add 'traefik.http.services.sigrep.loadbalancer.server.port=8080' \
  --label-add "traefik.http.routers.sigrep-web.rule=Host(\`$DOMAIN\`)" \
  --label-add 'traefik.http.routers.sigrep-web.entrypoints=web' \
  --label-add 'traefik.http.routers.sigrep-web.middlewares=sigrep-redirect-https' \
  --label-add 'traefik.http.middlewares.sigrep-redirect-https.redirectscheme.scheme=https' \
  --label-add 'traefik.http.middlewares.sigrep-redirect-https.redirectscheme.permanent=true' \
  "$SERVICE_NAME"

for segundos in 5 4 3 2 1 0; do
  printf 'Verificando labels en %s segundos...\n' "$segundos"
  [[ "$segundos" -eq 0 ]] || sleep 1
done

REGLA_HTTPS="$(docker service inspect "$SERVICE_NAME" --format '{{index .Spec.Labels "traefik.http.routers.sigrep.rule"}}')"
RED_TRAEFIK="$(docker service inspect "$SERVICE_NAME" --format '{{index .Spec.Labels "traefik.docker.network"}}')"
PUERTO="$(docker service inspect "$SERVICE_NAME" --format '{{index .Spec.Labels "traefik.http.services.sigrep.loadbalancer.server.port"}}')"
APP_NETWORKS="$(docker service inspect "$SERVICE_NAME" \
  --format '{{range .Spec.TaskTemplate.Networks}}{{println .Target}}{{end}}')"

if [[ "$REGLA_HTTPS" != "Host(\`$DOMAIN\`)" || "$RED_TRAEFIK" != "$NETWORK_NAME" || "$PUERTO" != "8080" ]] \
  || ! grep -Fxq "$NETWORK_ID" <<< "$APP_NETWORKS"; then
  echo "ERROR: los labels no quedaron aplicados como se esperaba." >&2
  docker service inspect "$SERVICE_NAME" --format '{{json .Spec.Labels}}' >&2
  docker service inspect "$SERVICE_NAME" --format '{{json .Spec.TaskTemplate.Networks}}' >&2
  exit 1
fi

ESTADO="$(docker service ps "$SERVICE_NAME" --format '{{.CurrentState}}' | head -n 1)"
printf 'Labels y red verificados. App: %s | DB: %s | https://%s | puerto %s | estado: %s\n' \
  "$SERVICE_NAME" "$DB_SERVICE" "$DOMAIN" "$PUERTO" "${ESTADO:-desconocido}"
printf 'La URL de base en Dokploy debe usar como host: %s\n' "$DB_SERVICE"