# Entorno con el que corren las pruebas. Fuente unica para la integracion
# continua y para la maquina de quien desarrolla.
#
# Este archivo existe por un fallo concreto: el CI corria las pruebas sobre
# SQLite en memoria (`sqlite://`) y en local se corrian sobre un archivo `.db`
# que ya tenia esquema y datos de una corrida anterior. Una prueba que dejaba
# el registro de motores vacio pasaba en local —el archivo ya estaba migrado— y
# tumbaba 31 pruebas en el CI. El sintoma parecia «el CI esta raro»; era que las
# dos cosas no corrian lo mismo.
#
# Quien lo lee:
#   - `.github/workflows/ci.yml`, trabajo `backend` (lo vuelca en $GITHUB_ENV).
#   - `scripts/pruebas-como-ci.sh` y `scripts/pruebas-como-ci.ps1`.
#
# Formato: `NOMBRE=valor`, sin comillas y sin expansiones. $GITHUB_ENV no admite
# otra cosa; los comentarios se filtran antes de volcarlo.

# Clave ficticia: la configuracion se niega a arrancar sin una, y en las pruebas
# no se firma nada que salga de la maquina.
SIGREP_SECRET_KEY=clave-de-integracion-continua-con-mas-de-32-caracteres

SIGREP_ENTORNO=pruebas

# SQLite EN MEMORIA. La barra doble y nada detras no es un descuido: es la base
# que nace vacia en cada proceso. `conftest.py` crea el esquema con
# `Base.metadata.create_all` y no necesita servidor.
#
# Apuntar esto a un archivo —`sqlite:///sigrep_local.db`— es lo que escondio el
# fallo: el archivo conserva estado entre corridas y perdona pruebas que dejan
# el proceso sucio.
SIGREP_DB_URL_OVERRIDE=sqlite://
