# Plantilla de configuración de SIGREP.
#
# Copie este archivo a `.env` y complete los valores. `.env` NUNCA se versiona:
# está en .gitignore y contiene credenciales reales.
#
# Todas las variables de la aplicación llevan el prefijo `SIGREP_` y las lee
# `backend/app/core/config.py`. Lo que no aparezca aquí y no esté en ese archivo
# simplemente se ignora (`extra="ignore"`).
#
# En Dokploy estos valores no viven en un archivo sino en el panel del servicio.
# Ver docs/DESPLIEGUE.md.

# ── Obligatorios ──────────────────────────────────────────────────────────────

# Clave de firma de los JWT. Mínimo 32 caracteres; la aplicación se niega a
# arrancar si falta o es más corta. Generar con:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SIGREP_SECRET_KEY=CAMBIE_ESTE_VALOR_POR_UNA_CLAVE_ALEATORIA_DE_48_CARACTERES

# Contraseña de la cuenta de aplicación en la base de datos. También la usa el
# contenedor de PostgreSQL de `docker-compose.yml` para inicializarse.
SIGREP_DB_PASSWORD=CAMBIE_Esta_Clave_2026!

# ── Entorno ───────────────────────────────────────────────────────────────────

# local | desarrollo | pruebas | produccion
# En `produccion` se cierran /docs, /redoc y /openapi.json, se envía HSTS y se
# activa la validación de cabecera Host.
SIGREP_ENTORNO=desarrollo

# Orígenes autorizados por CORS, separados por coma. Nunca `*` en producción.
# Sirviendo la interfaz por Nginx no hace falta ninguno —todo es mismo origen—,
# pero el modo `npm run dev` sí lo necesita.
SIGREP_CORS_ORIGENES=http://localhost:8080,http://localhost:5174

# Nombres de host que la API acepta en producción, separados por coma.
# Si se deja vacío se derivan de SIGREP_CORS_ORIGENES.
#
# Detrás de un proxy inverso el `Host` que llega es el del dominio público y
# puede no coincidir con el origen CORS. Cuando no coincide, la API responde
# 400 «Invalid host header» a TODO el tráfico y el mensaje no menciona CORS en
# ningún momento. Si ve ese error, declare el dominio aquí.
# SIGREP_HOSTS_PERMITIDOS=sigrep.grupo-santacruz.com

# ── Base de datos ─────────────────────────────────────────────────────────────

# postgresql | mssql
# El esquema es idéntico en ambos: los modelos usan tipos genéricos de
# SQLAlchemy. `mssql` exige instalar el extra `.[sqlserver]` y el driver ODBC.
SIGREP_DB_MOTOR=postgresql

# Nombre del servicio dentro de la red de Docker Compose; `localhost` sin Docker.
SIGREP_DB_SERVIDOR=postgres
SIGREP_DB_PUERTO=5432
SIGREP_DB_NOMBRE=sigrep
SIGREP_DB_USUARIO=sigrep_app

# `false` dentro de una red Docker privada: usa TLS si el servidor lo ofrece
# pero no lo exige. En una base gestionada expuesta a internet debe ser `true`.
SIGREP_DB_ENCRYPT=false

# Tamaño del pool de conexiones y conexiones extra que admite en picos.
SIGREP_DB_POOL_SIZE=10
SIGREP_DB_MAX_OVERFLOW=20

# Segundos tras los cuales una conexión del pool se recicla. Evita que un
# cortafuegos intermedio corte conexiones ociosas sin que SQLAlchemy se entere.
SIGREP_DB_POOL_RECYCLE_SEG=1800

# Vuelca a la consola cada sentencia SQL. Útil para depurar, ruidoso siempre.
SIGREP_DB_ECHO=false

# Solo SQL Server: nombre del driver ODBC y validación de su certificado.
# SIGREP_DB_DRIVER=ODBC Driver 18 for SQL Server
# SIGREP_DB_TRUST_CERT=false

# Alternativa: cadena de conexión completa. Tiene prioridad sobre todo lo
# anterior y es lo que se usa en Dokploy, Railway o Neon. Admite el esquema
# `postgres://` heredado; la aplicación lo normaliza al driver instalado.
# SIGREP_DB_URL_OVERRIDE=postgres://usuario:clave@host:5432/sigrep

# ── Reglas de negocio ─────────────────────────────────────────────────────────
#
# Son decisiones de Gerencia, no de Tecnología: por eso se ajustan sin desplegar.

# Umbral del semáforo (§4.1 de la especificación). Verde es
# `cumplimiento >= ideal`; amarillo llega hasta este factor del ideal y por
# debajo es rojo. PENDIENTE DE CONFIRMAR CON EL USUARIO: supuesto 0.90.
SIGREP_FACTOR_SEMAFORO_AMARILLO=0.90

# Días hábiles que se siembran para las zonas cuyo calendario aún no confirma el
# negocio (§8.1). Admite media jornada (27.5). PENDIENTE: supuesto 28.
SIGREP_DIAS_HABILES_POR_DEFECTO=28

# Implementación activa del puerto `FuenteVenta` (§5): `excel` lee el libro
# actual, `siesa` consumirá la API cuando el usuario la entregue. Cambiar de una
# a otra es esta variable, nunca un refactor.
SIGREP_FUENTE_VENTA=excel

# Ruta del libro de SIESA que lee `FuenteVentaExcel` en `POST /ingesta/ejecutar`.
# Sin ella esa carga responde 422 diciendo qué configurar; `POST /ingesta/archivo`
# —que trae el libro en la propia petición— sigue funcionando. No tiene valor por
# defecto a propósito: una ruta adivinada es una ingesta que carga el archivo
# equivocado en silencio.
# SIGREP_RUTA_ARCHIVO_VENTA=/datos/VENTA X PUNTO PRESUPUESTO.xlsx

# Tope de filas que devuelve un reporte de clientes sin paginar. Entre 10 y 5000.
SIGREP_MAX_FILAS_REPORTE_CLIENTES=500

# ── API de consulta de SIESA ──────────────────────────────────────────────────
#
# Solo se usan con SIGREP_FUENTE_VENTA=siesa. El porqué de cada valor está en el
# encabezado de `backend/app/infrastructure/fuentes/siesa.py`; aquí va lo justo
# para configurarlo sin tener que leerlo.

SIGREP_SIESA_URL_BASE=https://apiconsulta.grupo-santacruz.com

# Token de la API. ⚠️ SECRETO: no lo pegue en un ticket ni en un chat.
# Se envía en la cabecera `Authorization` con el valor PELADO: sin «Bearer» y
# sin el prefijo «1-» con que se entrega. Puede escribirlo aquí con prefijo o
# sin él, la aplicación lo quita sola. Nunca aparece en un log ni en un error.
SIGREP_SIESA_TOKEN=

# Compañías a consultar, separadas por coma. VACÍO ES LO CORRECTO: omitir
# `id_cia` devuelve las tres compañías de carnes (4, 6 y 7) en una sola
# consulta. Fijarlas parte la descarga en una petición por compañía, que sirve
# para acotar una incidencia sin desplegar.
# SIGREP_SIESA_COMPANIAS=4,6,7

# Centros de operación que SOLO sirve /ventas/pos-vendedor-detalle. Hoy es
# PEREIRA (409), que registra en otro módulo de POS de SIESA. El reparto entre
# los dos endpoints es excluyente y es lo que impide que unirlos duplique venta.
# El día que la API unifique los dos módulos, vacíe esta lista.
SIGREP_SIESA_CENTROS_POS_DETALLE=409

# Tiempos de espera, en segundos. La lectura es larga a propósito: un mes son
# ~1 000 000 de filas descargadas en streaming.
SIGREP_SIESA_TIMEOUT_CONEXION_SEG=15
SIGREP_SIESA_TIMEOUT_LECTURA_SEG=600

# Intentos ante un fallo de red o un 5xx, y espera entre uno y otro. Solo se
# reintenta lo que aún no entregó ninguna fila: reintentar una descarga cortada
# a la mitad duplicaría venta.
SIGREP_SIESA_REINTENTOS=3
SIGREP_SIESA_ESPERA_REINTENTO_SEG=2

# ── Sesión ────────────────────────────────────────────────────────────────────

# Vigencia del token de acceso, en minutos (5–480).
SIGREP_ACCESS_TOKEN_MINUTOS=30

# Vigencia del token de refresco, en días (1–30).
SIGREP_REFRESH_TOKEN_DIAS=7

# Intentos fallidos antes de bloquear la cuenta (3–10) y duración del bloqueo
# en minutos (5–120). Se bloquea la cuenta, no la IP.
SIGREP_MAX_INTENTOS_LOGIN=5
SIGREP_MINUTOS_BLOQUEO_CUENTA=15

# Algoritmo de firma de los JWT. No lo cambie sin motivo: HS256 es lo que
# espera el resto de la configuración.
# SIGREP_JWT_ALGORITMO=HS256

# ── Proceso del contenedor ────────────────────────────────────────────────────
#
# Estas dos NO las lee la aplicación: las lee `backend/docker/arranque.sh`.

# Workers de Uvicorn por contenedor de API.
SIGREP_WORKERS=2

# Intentos de `alembic upgrade head` al arrancar, con 5 s de espera entre uno y
# otro, antes de darse por vencido. Cubre la carrera de arranque con la base.
SIGREP_INTENTOS_MIGRACION=12

# ── Despliegue ────────────────────────────────────────────────────────────────
#
# Las lee `docker-compose.dokploy.yml`, no la aplicación.

# Dominio público de SIGREP. ⚠️ PENDIENTE DE DEFINIR POR EL USUARIO: el valor
# de abajo es un marcador de posición coherente con el de GSC ONE
# (`gsc.grupo-santacruz.com`), no un dominio confirmado. Fíjelo aquí y en
# SIGREP_CORS_ORIGENES antes de salir a producción.
SIGREP_DOMINIO=sigrep.grupo-santacruz.com

# Espacio de nombres del registro de imágenes y etiqueta a desplegar.
SIGREP_REGISTRO=ghcr.io/johnnyr-beep
SIGREP_VERSION=latest

# Réplicas de cada servicio en Swarm.
SIGREP_REPLICAS_API=1
SIGREP_REPLICAS_WEB=1
